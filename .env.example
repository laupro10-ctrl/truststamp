# TruthStamp — Variables de entorno
# Copia este archivo a .env.local y llena los valores
# Luego corre: npm run setup:stellar (genera estos valores automáticamente)

# Cuenta Stellar que actúa como registry de hashes (Testnet)
VITE_REGISTRY_PUBLIC_KEY=

# Secret key para firmar transacciones (SOLO testnet — nunca en producción)
VITE_REGISTRY_SECRET_KEY=

# Clave privada EVM para escribir entidades en Arkiv Braga testnet (0x...)
# Conseguir fondos de testnet: https://faucet.arkiv.network
VITE_ARKIV_PRIVATE_KEY=
